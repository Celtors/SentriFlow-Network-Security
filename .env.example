# Defaults, all bound to 127.0.0.1. No secrets belong in this file.
SENTRIFLOW_PROXY_PORT=8080
SENTRIFLOW_API_PORT=8787
SENTRIFLOW_HALT_TIMEOUT_SECONDS=30
SENTRIFLOW_LOG_LEVEL=INFO
SENTRIFLOW_API_ONLY=false
# Optional overrides; bundled blocklists and the GeoIP database are independent paths.
# SENTRIFLOW_BLOCKLIST_DIR=C:\path\to\blocklists
# SENTRIFLOW_GEOIP_DATABASE=C:\path\to\dbip-country-lite.mmdb
